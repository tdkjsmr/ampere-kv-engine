{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampere-kv.local/schemas/run-manifest.schema.json",
  "title": "AmpereKV Run Manifest",
  "description": "记录一次可复现运行所需的代码、模型、硬件、软件和功能开关。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at_utc",
    "git",
    "model",
    "hardware",
    "software",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "dtype"],
      "properties": {
        "id": {"type": "string"},
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dtype": {"type": "string"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gpu_name", "compute_capability"],
      "properties": {
        "gpu_name": {"type": ["string", "null"]},
        "gpu_uuid": {"type": ["string", "null"]},
        "compute_capability": {"type": ["string", "null"]},
        "memory_total_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": true,
      "required": ["python", "torch", "cuda_runtime"],
      "properties": {
        "python": {"type": "string"},
        "torch": {"type": ["string", "null"]},
        "triton": {"type": ["string", "null"]},
        "transformers": {"type": ["string", "null"]},
        "cuda_runtime": {"type": ["string", "null"]},
        "cuda_toolkit": {"type": ["string", "null"]},
        "driver": {"type": ["string", "null"]}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kv_dtype", "cuda_graph", "chunked_prefill"],
      "properties": {
        "kv_dtype": {"enum": ["bfloat16", "int8"]},
        "cuda_graph": {"type": "boolean"},
        "chunked_prefill": {"type": "boolean"}
      }
    }
  }
}
